node_modules/
.next/
reference/*
# ...EXCEPT the raw archive. Three sibling sites in this programme lost their
# reference to a bot wall mid-build and can never be re-measured against it.
# An ignored directory dies to the first `git clean -xdf`, so this one is tracked.
!reference/raw/
!reference/raw/**
*.tsbuildinfo
next-env.d.ts

# Harness artifacts: JSON traces are committed (they are the record), images are not.
.harness/**/*.png
.harness/devserver.log
.harness/prodserver.log
.harness/server.log

# This project installs with pnpm (pnpm-lock.yaml is the committed lockfile and
# Hostinger builds with it). An npm lockfile here would be a second source of
# truth for the dependency tree.
package-lock.json

# Static export output.
out/
